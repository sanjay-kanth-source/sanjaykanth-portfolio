const SHEET_NAME="Portfolio";
function doGet(){return jsonResponse(true,"Sanjay Kanth enquiry service is running.");}
function doPost(e){try{if(!e||!e.postData||!e.postData.contents)return jsonResponse(false,"No enquiry data received.");const d=JSON.parse(e.postData.contents);if(String(d.website||"").trim())return jsonResponse(false,"Spam submission blocked.");const name=String(d.name||"").trim(),email=String(d.email||"").trim(),phone=String(d.phone||"").trim(),service=String(d.service||"").trim(),message=String(d.message||"").trim(),source=String(d.source||"Website").trim();if(!name)return jsonResponse(false,"Please enter your name.");if(phone.replace(/\D/g,"").length<10)return jsonResponse(false,"Please enter a valid phone number.");if(!message)return jsonResponse(false,"Please enter your project details.");if(email&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))return jsonResponse(false,"Please enter a valid email address.");const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)return jsonResponse(false,"Spreadsheet could not be opened.");const sheet=ss.getSheetByName(SHEET_NAME);if(!sheet)return jsonResponse(false,'The "'+SHEET_NAME+'" worksheet was not found.');if(sheet.getLastRow()===0)sheet.appendRow(["Timestamp","Source","Name","Email","Phone","Service","Message","Status"]);sheet.appendRow([new Date(),source,name,email,phone,service,message,"New"]);return jsonResponse(true,"Enquiry received successfully.");}catch(err){console.error(err);return jsonResponse(false,"Unable to process enquiry: "+err.message);}}
function jsonResponse(success,message){return ContentService.createTextOutput(JSON.stringify({success:success,message:message})).setMimeType(ContentService.MimeType.JSON);}
function testSheet(){const sheet=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);Logger.log(sheet?sheet.getName():"Portfolio sheet not found");}
